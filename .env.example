# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Exact public origin. Used for CSRF validation and email confirmation links.
APP_URL=http://localhost:3000

# Optional: ONLY for the manual demo seed script. Never used by API routes.
# SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
# SEED_DEMO_PASSWORD=Choose-A-Strong-Demo-Password
