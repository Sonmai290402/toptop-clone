# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://curkmutateuhkhyemfeq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7HY4V0JkD7H_b-RXVQ2ihw_1D6gmk1k
# Exact public origin. Used for CSRF validation and email confirmation links.
APP_URL=http://localhost:3000

UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
REDIS_KEY_PREFIX=toptop:development

# Optional: ONLY for the manual demo seed script. Never used by API routes.
# SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
# SEED_DEMO_PASSWORD=Choose-A-Strong-Demo-Password

# Set to false to bypass server-side Redis caching.
REDIS_CACHE_ENABLED=true

# Independent switch for distributed API rate limits.
REDIS_RATE_LIMIT_ENABLED=true
